# 이 파일을 .env 로 복사한 뒤 값을 채워주세요.
# Supabase 값이 비어 있으면 npm run dev 에서 RSVP·방명록은 브라우저 localStorage에 저장되는 로컬 모드로 동작합니다.

# Supabase 프로젝트 > Project Settings > API Keys (README의 "Supabase 설정" 참고)
# URL 예: https://xxxxxxxx.supabase.co
# KEY: publishable 키(sb_publishable_…) 또는 anon 키. secret/service_role 키는 절대 넣지 마세요.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 카카오 디벨로퍼스 > 앱 > 플랫폼 키 > JavaScript 키
# (카카오톡 공유 + 카카오맵에 함께 사용)
VITE_KAKAO_JS_KEY=
