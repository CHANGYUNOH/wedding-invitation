# 이 파일을 .env 로 복사한 뒤 값을 채워주세요.
# VITE_SHEETS_API_URL 이 비어 있으면 RSVP·방명록은 브라우저 localStorage에 저장되는 로컬 모드로 동작합니다.

# 구글 시트 Apps Script 웹 앱 주소 (README의 "구글 시트 설정" 참고)
# 예: https://script.google.com/macros/s/xxxxxxxx/exec
VITE_SHEETS_API_URL=

# 카카오 디벨로퍼스 > 앱 > 플랫폼 키 > JavaScript 키
# (카카오톡 공유 + 카카오맵에 함께 사용)
VITE_KAKAO_JS_KEY=
